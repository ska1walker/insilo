# ============================================================================
# Insilo - Umgebungsvariablen
# ============================================================================
# Lokale Dev-Umgebung. Im Olares-Deployment werden diese Werte automatisch
# über Helm-Values aus den System-Middlewares injiziert (siehe olares/values.yaml).
# ============================================================================

# ---- Datenbank (Olares-System-Postgres / lokal Docker-Compose) -------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insilo
DB_USER=insilo
DB_PASSWORD=insilo_dev_only

# ---- Redis / KVRocks --------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_NAMESPACE=insilo

# ---- Object Storage (Olares-System-MinIO / lokal Docker-Compose) -----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=insilo_dev
MINIO_SECRET_KEY=insilo_dev_secret
MINIO_BUCKET=insilo-audio
MINIO_USE_SSL=false

# ---- Interne KI-Services ---------------------------------------------------
# Lokal: Service auf localhost oder via docker-compose
# Olares: Kubernetes-DNS (z.B. http://insilo-whisper:8001)
WHISPER_URL=http://localhost:8001
EMBEDDINGS_URL=http://localhost:8002

# ---- LLM (OpenAI-kompatibel) -----------------------------------------------
# Lokal: nativ via `brew install ollama && ollama serve` — Ollama exposed
# eine OpenAI-kompatible API auf /v1.
# Olares: wir reden via Helm-injected URL mit der LiteLLM-Gateway-App.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=sk-local
LLM_MODEL=qwen2.5:7b-instruct

# ---- Storage-Pfade ---------------------------------------------------------
# Lokal: relative Pfade
# Olares: /app/data und /app/cache werden gemountet
APP_DATA_DIR=./data
APP_CACHE_DIR=./cache

# ---- App-Konfiguration -----------------------------------------------------
APP_LANG=de
APP_TIMEZONE=Europe/Berlin
AUDIO_RETENTION_DAYS=90
MAX_UPLOAD_MB=500

# ---- Olares-Kontext (lokal mit Dev-Werten überschreiben) -------------------
OLARES_USER=devuser
OLARES_ZONE=devuser.olares.local

# ---- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USER=devuser

# ---- Torwächter vor dem Backend --------------------------------------------
# Gemeinsames Geheimnis zwischen Next.js-Server und Backend. In Betrieb legt
# der Helm-Chart es als Secret an und gibt es beiden Deployments; der
# Next.js-Server hängt es an jeden weitergereichten Aufruf, das Backend
# verlangt es. Ohne gültiges Geheimnis wird `X-Bfl-User` nicht angesehen.
#
# Leer lassen heißt „offen" — für die lokale Entwicklung in Ordnung, in
# Betrieb nicht. Das Backend sagt es beim Start ins Protokoll.
INSILO_INTERNAL_TOKEN=

# Legt ein unbekannter Name Nutzer UND Organisation an? Nur lokal.
# In Betrieb aus (Vorgabe), sonst genügt ein ausgedachter Name, um sich
# eine eigene Organisation zu verschaffen und darin Inhaber zu sein.
INSILO_AUTO_PROVISION=true

# ---- Entwicklung -----------------------------------------------------------
LOG_LEVEL=info
DEBUG=true
